{
  "version": "0.2.0",
  "configurations": [
    
    {
      // Debug the app on the Android emulator against the local server.
      // Pick the emulator in VS Code's device selector first. The emulator
      // reaches this PC at 10.0.2.2 (its own `localhost` is the emulator),
      // so the URL from assets/config.json can't be used here. Start the
      // server first in a terminal: `serverpod start --no-flutter`.
      "name": "Plotwatch app (mobile debug mode)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/plotwatch_flutter",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "args": [
        "--dart-define=SERVER_URL=http://10.0.2.2:8080/"
      ],
      // "preLaunchTask": "serverpod_start_server_only"
    },
    {
      // Debug the live web app (hot reload) in Chrome against the local
      // server, always at http://localhost:8083, so an invitation link is
      // http://localhost:8083/join/<code>. Port 8082 is the server's built
      // copy (plotwatch_server/web/app), which only changes with
      // `serverpod run flutter_build`. Start the server first in a terminal:
      // `serverpod start --no-flutter`.
      "name": "Plotwatch app (web debug mode)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/plotwatch_flutter",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "flutterMode": "debug",
      "args": [
        "--web-port=8083",
        "--dart-define=SERVER_URL=http://localhost:8080/",
        // Web Maps key from your environment, never committed (doc/04b
        // G-2): set PLOTWATCH_MAPS_WEB_KEY, then restart VS Code.
        "--dart-define=MAPS_API_KEY=${env:PLOTWATCH_MAPS_WEB_KEY}"
      ]
    },
    {
      // Debug the app on a device or emulator against Serverpod Cloud
      // (M1 check "Android against Cloud"). No local server needed.
      "name": "Plotwatch app (Cloud server)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/plotwatch_flutter",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=SERVER_URL=https://plotwatch.api.serverpod.space/"
      ]
    },
    // If the server pubspec configures multiple Flutter apps, add an attach
    // configuration like this for each app and add every configuration name
    // to the compound below. Use the VM-service info file pattern
    // `${workspaceFolder}/plotwatch_server/.dart_tool/serverpod/flutter-vm-service-info-<appId>.json`,
    // where `<appId>` is the app's key under `serverpod.flutter_apps` in the
    // server pubspec.
    {
      // Attaches to the Flutter app `serverpod start` spawns. Don't
      // launch a second instance here - it would race for the port.
      "name": "plotwatch_flutter",
      "type": "dart",
      "request": "attach",
      "vmServiceInfoFile": "${workspaceFolder}/plotwatch_server/.dart_tool/serverpod/flutter-vm-service-info-plotwatch.json",
      "preLaunchTask": "serverpod_start",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "plotwatch_server",
      "type": "dart",
      "request": "attach",
      "vmServiceInfoFile": "${workspaceFolder}/plotwatch_server/.dart_tool/serverpod/vm-service-info.json",
      "preLaunchTask": "serverpod_start",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "compounds": [
    {
      "name": "plotwatch (full stack)",
      "configurations": [
        "plotwatch_server",
        "plotwatch_flutter"
      ],
      // Stopping one session stops both; the orphan blocks re-attach.
      "stopAll": true,
      "presentation": {
        "order": 1
      }
    }
  ]
}